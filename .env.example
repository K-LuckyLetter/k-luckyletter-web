NEXT_PUBLIC_API_URL=http://localhost:4000
# 검색엔진 소유 확인 코드(선택). Google Search Console, 네이버 서치어드바이저에서 받은 값.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# 메인 화면 배너 광고(선택). Google AdSense 게시자 ID(ca-pub-…)와 광고 단위 ID.
# 게시자 ID만 넣으면 사이트 확인용 태그와 ads.txt 만 나가고, 둘 다 넣으면 광고가 나온다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
# 방문 통계(선택). Cloudflare Web Analytics 에서 받은 토큰.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
